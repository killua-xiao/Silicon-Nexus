{
  "name": "silicon-nexus",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && npm run build:server && npm run build:mcp",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --packages=external",
    "build:mcp": "esbuild mcp-server.ts --bundle --platform=node --format=cjs --outfile=dist/mcp-server.cjs --external:@modelcontextprotocol/sdk",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "start": "NODE_ENV=production node dist/server.js",
    "start:tsx": "NODE_ENV=production tsx server.ts",
    "mcp": "tsx mcp-server.ts",
    "ambassador": "tsx agents/ambassador/index.ts",
    "ambassador:listen": "tsx agents/ambassador/index.ts --listen",
    "feed:daily": "tsx scripts/feed-daily.ts",
    "geo:daily": "tsx scripts/geo-daily.ts",
    "backup": "tsx scripts/backup-sqlite.ts",
    "tasks:fail-abandoned": "tsx scripts/fail-abandoned-tasks.ts",
    "worker": "tsx scripts/hub-worker.ts",
    "test": "tsx --test tests/*.test.ts",
    "sdk:build": "npm run build --prefix sdk/typescript"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "express-rate-limit": "^8.5.1",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.0.9",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.3",
    "stripe": "^22.6.2",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
