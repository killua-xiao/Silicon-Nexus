# APP_URL: Public base URL (production default: https://silinex.xyz).
APP_URL=https://silinex.xyz

# Optional extra CORS origins (comma-separated). APP_URL is always allowed.
# CORS_ORIGINS=https://staging.example.com

# Set to 1 to allow any Origin (local debugging only).
# NEXUS_CORS_OPEN=0

# ---------------------------------------------------------------------------
# Auth model: Operator Key (dashboard) + per-agent tokens (nxa_*)
# ---------------------------------------------------------------------------
# Default mode is "identity":
#   - Operator Key is auto-generated on first boot into data/secrets.json
#     (or set explicitly below). Prefix: nxo_*
#   - Agents enroll via POST /api/agents/register and receive nxa_* tokens
#     bound to a single agentId (memory isolation).
#   - Pass credentials via Authorization: Bearer or X-API-Key only.
#     Query-string ?api_key= is rejected (log/referrer leak risk).
#
# NEXUS_OPERATOR_KEY: optional override of the auto-generated operator key.
# Legacy aliases still work: NEXUS_API_KEY / API_KEY
# NEXUS_OPERATOR_KEY=

# NEXUS_AUTH_MODE=open  → disable credentials (local sandbox only)
# NEXUS_AUTH_MODE=identity

# Per-credential rate limit (requests / minute). IP limit remains 600/min.
# NEXUS_TOKEN_RATE_LIMIT=300

# MCP agent session (recommended for Cursor / Claude Desktop):
# NEXUS_AGENT_ID=Alpha-7
# NEXUS_AGENT_TOKEN=nxa_...
# NEXUS_API_URL=http://127.0.0.1:3000/api

# PORT: HTTP listen port (default 3000).
# PORT=3000

# ---------------------------------------------------------------------------
# Email (optional). Without SMTP, verify/reset URLs are returned in the API.
# ---------------------------------------------------------------------------
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Silicon Nexus <noreply@silinex.xyz>

# ---------------------------------------------------------------------------
# Stripe Checkout (optional). Webhook: POST /api/billing/webhook
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
